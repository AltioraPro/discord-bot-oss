# ---- Discord (required) ----

# Bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=

# The guild (server) the bot operates in
DISCORD_GUILD_ID=

# Comma separated voice channel ids that start a deepwork session on join
DEEPWORK_VOICE_CHANNEL_IDS=

# ---- Inbound oRPC server ----

# Port the bot listens on. Defaults to 3001 when unset.
BOT_PORT=3001

# Shared secret required on inbound webhook calls. At least 16 characters.
WEBHOOK_SECRET=

# ---- External backend (optional) ----
# Leave all three empty to run in degraded mode, where deepwork sessions
# are kept in memory only and nothing is persisted.
# APP_URL and API_SECRET must be set together.

# Base URL of the backend exposing oRPC at {APP_URL}/api/rpc
APP_URL=

# Bearer token sent to the backend
API_SECRET=

# Where to redirect after the Discord OAuth callback
OAUTH_REDIRECT_URL=

# ---- Deepwork timing (optional) ----

# How often the bot asks whether you are still working. Defaults to 30.
DEEPWORK_CHECKIN_INTERVAL_MINUTES=30

# How long to wait for an answer before ending the session and disconnecting
# the member from voice. Defaults to 5.
DEEPWORK_CHECKIN_TIMEOUT_MINUTES=5

# Session length used when the bot cannot send a direct message, which happens
# when the member has direct messages from server members turned off.
# Defaults to 120.
DEEPWORK_DEFAULT_DURATION_MINUTES=120

# ---- Roles (optional) ----
# One Discord role id per rank, plus premium. Leave any unset to skip that
# rank; a sync request for an unconfigured rank fails and says which is missing.

DISCORD_ROLE_NEW=
DISCORD_ROLE_BEGINNER=
DISCORD_ROLE_RISING=
DISCORD_ROLE_CHAMPION=
DISCORD_ROLE_EXPERT=
DISCORD_ROLE_LEGEND=
DISCORD_ROLE_MASTER=
DISCORD_ROLE_GRANDMASTER=
DISCORD_ROLE_IMMORTAL=
DISCORD_ROLE_PREMIUM=

# ---- Runtime (optional) ----

# Minimum log level: debug, info, warn or error. Defaults to info.
LOG_LEVEL=info

# development, production or test. Defaults to development.
# Set to production for one JSON log object per line.
NODE_ENV=development
