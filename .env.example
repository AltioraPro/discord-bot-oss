# ---- Discord (required) ----

# Bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=

# The guild (server) the bot operates in
DISCORD_GUILD_ID=

# Comma separated voice channel ids that start a deepwork session on join
DEEPWORK_VOICE_CHANNEL_IDS=

# ---- Inbound oRPC server ----

# Port the bot listens on. Defaults to 3001 when unset.
BOT_PORT=3001

# Shared secret required on inbound webhook calls. At least 16 characters.
WEBHOOK_SECRET=

# ---- External backend (optional) ----
# Leave all three empty to run in degraded mode, where deepwork sessions
# are kept in memory only and nothing is persisted.
# APP_URL and API_SECRET must be set together.

# Base URL of the backend exposing oRPC at {APP_URL}/api/rpc
APP_URL=

# Bearer token sent to the backend
API_SECRET=

# Where to redirect after the Discord OAuth callback
OAUTH_REDIRECT_URL=
